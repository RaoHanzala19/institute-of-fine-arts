@{
    var code = (int)(ViewData["Code"] ?? 500);
    ViewData["Title"] = code == 404 ? "Page not found" : "Error " + code;
    var (headline, text) = code switch
    {
        404 => ("This page has wandered off the canvas.", "The page you were looking for doesn't exist or has been moved."),
        403 => ("This room is members only.", "Your account doesn't have permission to open this page."),
        _ => ("Something went wrong.", "An unexpected error occurred. Please try again in a moment.")
    };
}
<div class="status-page">
    <div>
        <div class="code">@code</div>
        <h2 class="mb-2">@headline</h2>
        <p class="text-muted mb-4">@text</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to the home page</a>
    </div>
</div>
