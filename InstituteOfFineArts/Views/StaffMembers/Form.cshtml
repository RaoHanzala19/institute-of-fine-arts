@model StaffFormVm
@{
    var isEdit = Model.StaffId > 0;
    ViewData["Title"] = isEdit ? "Edit staff member" : "Add staff member";
}
<div class="page-head">
    <div><a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? Model.StaffId : null)" class="back-link"><i class="bi bi-arrow-left"></i>Back</a><h1 class="page-title">@ViewData["Title"]</h1></div>
</div>
<form method="post" novalidate>
    <input type="hidden" asp-for="StaffId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-soft-danger"></div>

    <div class="form-section">
        <div class="section-head"><span class="ico"><i class="bi bi-person-badge"></i></span><div><h3>Account</h3><p>Staff members can create competitions, evaluate paintings and issue awards.</p></div></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" readonly="@isEdit" autocomplete="off" /><span asp-validation-for="Email"></span></div>
            @if (!isEdit)
            {
                <div class="col-md-6"><label asp-for="Password" class="form-label">Starting password</label>
                    <div class="input-group"><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" /><button class="btn btn-soft" type="button" data-toggle-password="#Password" tabindex="-1"><i class="bi bi-eye"></i></button></div>
                    <span asp-validation-for="Password"></span></div>
            }
            else
            {
                <div class="col-md-6 d-flex align-items-end"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Account is active</label></div></div>
            }
        </div>
    </div>

    <div class="form-section">
        <div class="section-head"><span class="ico"><i class="bi bi-person"></i></span><div><h3>Personal details</h3></div></div>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName"></span></div>
            <div class="col-md-4"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName"></span></div>
            <div class="col-md-4"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select"><option value="">— select —</option><option>Female</option><option>Male</option><option>Other</option></select><span asp-validation-for="Gender"></span></div>
            <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /><span asp-validation-for="DateOfBirth"></span></div>
            <div class="col-md-4"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber"></span></div>
            <div class="col-md-4"><label asp-for="EmergencyContact" class="form-label"></label><input asp-for="EmergencyContact" class="form-control" /></div>
            <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address"></span></div>
        </div>
    </div>

    <div class="form-section">
        <div class="section-head"><span class="ico"><i class="bi bi-briefcase"></i></span><div><h3>Employment</h3></div></div>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="Designation" class="form-label"></label><input asp-for="Designation" class="form-control" placeholder="Senior Instructor" /></div>
            <div class="col-md-4"><label asp-for="Qualification" class="form-label"></label><input asp-for="Qualification" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="DateJoined" class="form-label"></label><input asp-for="DateJoined" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /><span asp-validation-for="DateJoined"></span></div>
            <div class="col-md-6"><label asp-for="HandlesClass" class="form-label"></label><input asp-for="HandlesClass" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="HandlesSubject" class="form-label"></label><input asp-for="HandlesSubject" class="form-control" /></div>
            <div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="2" maxlength="1000"></textarea></div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-lg" type="submit">@(isEdit ? "Save changes" : "Add staff member")</button>
        <a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? Model.StaffId : null)" class="btn btn-soft btn-lg">Cancel</a>
    </div>
</form>
