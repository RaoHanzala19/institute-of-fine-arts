@model List<Award>
@{
    ViewData["Title"] = "My awards";
}
<div class="page-head"><div><h1 class="page-title">My awards</h1><p class="page-sub">Prizes you have won. Print a certificate for any of them.</p></div></div>
@if (Model.Count == 0)
{
    <div class="panel"><div class="panel-body"><partial name="_Empty" model='("bi-award", "No awards yet", "Keep entering — your first award is one painting away.")' /></div></div>
}
else
{
    <div class="grid-cards wide">
        @foreach (var a in Model)
        {
            <div class="panel"><div class="panel-body">
                <div class="d-flex gap-3">
                    <img src="@(a.WinningSubmission.ThumbnailPath ?? a.WinningSubmission.ImageFilePath)" alt="" style="width:104px;height:104px;object-fit:cover;border-radius:12px" />
                    <div class="min-w-0">
                        <span class="chip chip-gold mb-1"><i class="bi bi-award-fill"></i>@a.DisplayTitle</span>
                        <h4 class="mb-0">@a.Competition.Title</h4>
                        <div class="row-sub">“@a.WinningSubmission.PaintingTitle”</div>
                        <div class="row-sub mono mt-1">@a.CertificateNumber · @Ui.Date(a.DateIssued)</div>
                    </div>
                </div>
                @if (a.CompetitionAward?.PrizeMoney != null) { <div class="mt-3 d-flex justify-content-between"><span class="text-muted">Prize money</span><strong>@Ui.Money(a.CompetitionAward.PrizeMoney)</strong></div> }
                @if (!string.IsNullOrWhiteSpace(a.Remarks)) { <p class="small text-muted mt-3 mb-0">“@a.Remarks”</p> }
                <a asp-controller="Certificates" asp-action="Certificate" asp-route-id="@a.AwardId" class="btn btn-primary btn-sm mt-3"><i class="bi bi-printer me-1"></i>View certificate</a>
            </div></div>
        }
    </div>
}
