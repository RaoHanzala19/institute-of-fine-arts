@model AnnouncementFormVm
@{
    var isEdit = Model.AnnouncementId > 0;
    ViewData["Title"] = isEdit ? "Edit announcement" : "New announcement";
}
<div class="page-head"><div><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Announcements</a><h1 class="page-title">@ViewData["Title"]</h1></div></div>
<div class="row"><div class="col-lg-8">
    <form method="post" class="form-section" novalidate>
        <input type="hidden" asp-for="AnnouncementId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-soft-danger"></div>
        <div class="row g-3">
            <div class="col-12"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title"></span></div>
            <div class="col-12"><label asp-for="Body" class="form-label"></label><textarea asp-for="Body" class="form-control" rows="6" maxlength="4000"></textarea><span asp-validation-for="Body"></span></div>
            <div class="col-md-4"><label asp-for="Audience" class="form-label"></label><select asp-for="Audience" asp-items="Ui.EnumItems(Model.Audience)" class="form-select"></select><div class="form-text">“Everyone” also appears on the public home page.</div></div>
            <div class="col-md-4"><label asp-for="ExpiresAt" class="form-label"></label><input asp-for="ExpiresAt" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>
            <div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch"><input asp-for="IsPinned" class="form-check-input" /><label asp-for="IsPinned" class="form-check-label"></label></div></div>
        </div>
        <div class="d-flex gap-2 mt-4"><button class="btn btn-primary btn-lg" type="submit">@(isEdit ? "Save changes" : "Publish")</button><a asp-action="Index" class="btn btn-soft btn-lg">Cancel</a></div>
    </form>
</div></div>
