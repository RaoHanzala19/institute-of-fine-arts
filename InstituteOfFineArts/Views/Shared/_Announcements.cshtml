@model List<Announcement>
@if (Model.Count > 0)
{
    <div class="panel">
        <div class="panel-head"><h3><i class="bi bi-megaphone me-2 text-primary"></i>Announcements</h3></div>
        <div class="panel-body d-grid gap-3">
            @foreach (var a in Model)
            {
                <div>
                    <div class="fw-semibold">@if (a.IsPinned) { <i class="bi bi-pin-angle-fill text-primary me-1"></i> }@a.Title</div>
                    <div class="small text-muted">@a.Body</div>
                    <div class="row-sub mt-1">@Ui.TimeAgo(a.PublishedAt)@(a.CreatedBy != null ? " · " + a.CreatedBy.FullName : "")</div>
                </div>
            }
        </div>
    </div>
}
