@model List<Notification>
@{
    var unread = (int)(ViewData["Unread"] ?? 0);
    (string Icon, string Style) Look(NotificationType t) => t switch
    {
        NotificationType.Success => ("bi-trophy", "background:var(--success-soft);color:var(--success)"),
        NotificationType.Warning => ("bi-exclamation-triangle", "background:var(--warning-soft);color:var(--warning)"),
        _ => ("bi-info-circle", "background:var(--info-soft);color:var(--info)")
    };
}
<div class="dropdown">
    <button class="top-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-label="Notifications" aria-expanded="false">
        <i class="bi bi-bell"></i>
        @if (unread > 0) { <span class="notif-dot">@(unread > 9 ? "9+" : unread.ToString())</span> }
    </button>
    <div class="dropdown-menu dropdown-menu-end bell-menu">
        <div class="d-flex justify-content-between align-items-center px-3 py-2" style="border-bottom:1px solid var(--line-2)">
            <strong>Notifications</strong>
            @if (unread > 0)
            {
                <form asp-controller="Notifications" asp-action="MarkAllRead" method="post" data-no-loading>
                    <button class="btn btn-sm btn-ghost py-0" type="submit">Mark all read</button>
                </form>
            }
        </div>
        @if (Model.Count == 0)
        {
            <div class="empty py-4"><i class="bi bi-bell-slash"></i><div class="small">You're all caught up.</div></div>
        }
        else
        {
            foreach (var n in Model)
            {
                var look = Look(n.Type);
                <a asp-controller="Notifications" asp-action="Open" asp-route-id="@n.NotificationId" class="notif @(n.IsRead ? "" : "unread")">
                    <span class="ico" style="@look.Style"><i class="bi @look.Icon"></i></span>
                    <span class="flex-grow-1">
                        <span class="title d-block small">@n.Title</span>
                        <span class="text-muted d-block" style="font-size:.76rem">@Ui.TimeAgo(n.CreatedAt)</span>
                    </span>
                </a>
            }
        }
        <a asp-controller="Notifications" asp-action="Index" class="d-block text-center small fw-semibold py-2" style="border-top:1px solid var(--line-2)">View all</a>
    </div>
</div>
