@model ResetPasswordVm
@{
    ViewData["Title"] = "Reset password";
}
<div class="page-head"><div><a href="javascript:history.back()" class="back-link"><i class="bi bi-arrow-left"></i>Back</a><h1 class="page-title">Reset password</h1><p class="page-sub">Set a new temporary password for <strong>@Model.DisplayName</strong>. Tell them to change it after signing in.</p></div></div>
<div class="row"><div class="col-lg-6">
    <form asp-action="ResetPassword" method="post" class="form-section" novalidate>
        <input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="DisplayName" /><input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-soft-danger"></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
        <button class="btn btn-primary" type="submit">Reset password</button>
    </form>
</div></div>
