@model ProfileVm
@{
    ViewData["Title"] = "My profile";
    var full = $"{Model.FirstName} {Model.LastName}";
}
<div class="page-head">
    <div><h1 class="page-title">My profile</h1><p class="page-sub">Keep your contact details up to date.</p></div>
    <div class="page-actions"><a asp-action="ChangePassword" class="btn btn-soft"><i class="bi bi-key me-1"></i>Change password</a></div>
</div>
<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel"><div class="panel-body text-center py-5">
            @Html.Avatar(full, "xl")
            <h3 class="mt-3 mb-1">@full</h3>
            <div class="mb-2">@Html.RoleChip(Model.Role)</div>
            <div class="text-muted small">@Model.Email</div>
        </div></div>
    </div>
    <div class="col-lg-8">
        <form asp-action="Profile" method="post" class="form-section">
            <div class="section-head"><span class="ico"><i class="bi bi-person"></i></span><div><h3>Personal details</h3><p>Your email is your login and can only be changed by an administrator.</p></div></div>
            <div asp-validation-summary="ModelOnly" class="alert alert-soft-danger"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName"></span></div>
                <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName"></span></div>
                <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" value="@Model.Email" readonly /></div>
                <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber"></span></div>
                @if (Model.HasProfileRecord)
                {
                    <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address"></span></div>
                }
            </div>
            <button type="submit" class="btn btn-primary mt-4">Save changes</button>
        </form>
    </div>
</div>
